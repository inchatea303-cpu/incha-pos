{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/|incha-pos\\.apk).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
